# Optional model/VLM endpoint. The MVP runs without it and creates editable JSON scaffolds.
MODEL_PROVIDER=local
MODEL_API_KEY=
MODEL_BASE_URL=

# Legacy custom API mode only; the Spielkiste page uses its own AI settings.
GEMINI_API_KEY=
SFX_GEMINI_MODEL=gemini-2.5-flash
# Optional legacy override; unnecessary for the fixed workbench workflow.
SFX_USE_GEMINI=0

# Spielkiste: no .env file is required. Use the page's AI connection settings.
# Explicit gateway URL/config path below override saved page settings; leave blank.
SFX_USE_CCSWITCH=1
# Model sent through the local CC Switch gateway. Gemini is the default.
SFX_CCSWITCH_MODEL=
# Dense video sampling interval in seconds.
SFX_MODEL_SAMPLE_SECONDS=1.25
# Optional override; defaults to %USERPROFILE%\\.codex\\config.toml on Windows.
SFX_CCSWITCH_CONFIG=
# Optional user-level Spielkiste AI settings path. Keep credentials out of the repo.
SFX_AI_CONFIG_PATH=
# Optional manual gateway overrides for this tool only (the UI can save these to a user-level file).
SFX_CCSWITCH_BASE_URL=
SFX_CCSWITCH_BEARER=
SFX_CCSWITCH_WIRE_API=

# Optional FFmpeg installation overrides (usually auto-detected or on PATH).
FFMPEG_PATH=
FFPROBE_PATH=

# Feishu-Skill / feishu-tool integration.
# Task/member operations usually require user auth.
FEISHU_AUTH_TYPE=tenant

# Official Lark/Feishu CLI. Preferred over legacy feishu-tool when available.
LARK_CLI_PATH=lark-cli

# Optional MOSS-Audio integration. Leave empty to keep the editable local scaffold mode.
# Example command mode:
# MOSS_AUDIO_COMMAND=python F:\MOSS-Audio\infer_cli.py --audio-path {{audioPath}} --prompt {{prompt}}
# Or script mode:
MOSS_AUDIO_PYTHON=
MOSS_AUDIO_SCRIPT=
MOSS_AUDIO_MODEL_PATH=
MOSS_AUDIO_TIMEOUT_MS=300000
